# Candidate Prioritization Skill — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.

# Chat gpt open AI
OPENAI_API_KEY=your-gemini-api-key-here

# Notion integration token
# Get it at: https://www.notion.so/profile/integrations → New integration → copy secret
NOTION_TOKEN=secret_...

# Notion parent page ID (the 32-char ID from the page URL)
NOTION_PAGE_ID=your_page_id_here
